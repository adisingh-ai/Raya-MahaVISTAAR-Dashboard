# RAYA API credentials (server-side only, on the machine that runs the API)
RAYA_API_KEY=""
RAYA_AGENT_ID=""

# Optional: set to "true" to show full caller numbers instead of masked ones
SHOW_FULL_NUMBERS=""

# On Vercel only: public URL of the machine running `npm run backend`.
# Example: API_PROXY_TARGET=https://your-name.ngrok-free.dev
# Leave empty locally. Do not set NEXT_PUBLIC_API_BASE.
API_PROXY_TARGET=""
