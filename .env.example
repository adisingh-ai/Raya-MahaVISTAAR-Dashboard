# RAYA API credentials (server-side only, never sent to the browser)
RAYA_API_KEY=""
RAYA_AGENT_ID=""

# Optional: set to "true" to show full caller numbers instead of masked ones
SHOW_FULL_NUMBERS=""

# --- Split hosting (Vercel UI + local API) ---
# On Vercel only: public HTTPS URL of the machine running `npm start` (e.g. Cloudflare Tunnel).
# Leave empty for local same-origin use.
NEXT_PUBLIC_API_BASE=""

# On the local API machine only: comma-separated browser origins allowed to call the API
# (your Vercel URL, plus preview URLs if needed). Example:
# CORS_ORIGINS="https://your-app.vercel.app"
CORS_ORIGINS=""
