# RAYA API credentials (server-side only, never sent to the browser)
RAYA_API_KEY=""
RAYA_AGENT_ID=""

# Optional: set to "true" to show full caller numbers instead of masked ones
SHOW_FULL_NUMBERS=""

# --- Split hosting (Vercel UI + tunnel API) ---
# On Vercel only (server-side): Cloudflare Tunnel URL of the API machine.
# Example: API_PROXY_TARGET=https://relationships-vitamins-unix-pants.trycloudflare.com
# Leave empty locally. Do NOT set NEXT_PUBLIC_API_BASE on Vercel when using this.
API_PROXY_TARGET=""

# Deprecated for Vercel: browser→tunnel CORS. Prefer API_PROXY_TARGET instead.
NEXT_PUBLIC_API_BASE=""
CORS_ORIGINS=""
